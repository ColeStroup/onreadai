# development, preview, or production. Vercel production may infer this from VERCEL_ENV.
APP_ENVIRONMENT="development"

# Local Docker defaults. Production uses Render's pooled URL for application
# traffic and its direct URL for migrations, both with TLS required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_growth_consultant?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_growth_consultant?schema=public"
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="10000"
DATABASE_IDLE_TIMEOUT_MS="10000"

# Public application origin used for redirects, canonical URLs, and social metadata.
# Replace this with the HTTPS production origin before deploying.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth login credentials. These are only for signing in with Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server-only Google Maps / Places discovery key.
# This is separate from Google login and is used to find public Google Business listings.
GOOGLE_PLACES_API_KEY=""
# Optional fallback if your Google Maps key is already named this way.
GOOGLE_MAPS_API_KEY=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# Selective AI audit review is server-only and defaults off in every environment.
AI_ASSISTED_AUDITS_ENABLED="false"
# Optional audit-specific overrides. When omitted, both routes inherit OPENAI_MODEL.
OPENAI_AUDIT_PAGE_MODEL="gpt-5.4-mini"
OPENAI_AUDIT_SYNTHESIS_MODEL="gpt-5.4-mini"

# Use test outside public production and live only after the live Stripe setup is complete.
STRIPE_MODE="test"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FULL_AUDIT=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""

# Partner Program rollout controls. These values bootstrap the database-backed
# settings record only on first use; later changes are made in Partner Admin.
PARTNER_PROGRAM_ENABLED="false"
PARTNER_APPLICATIONS_OPEN="false"
PARTNER_REFERRAL_ATTRIBUTION_ENABLED="false"
PARTNER_COMMISSION_CREATION_ENABLED="false"
PARTNER_SCANNER_ENABLED="false"
PARTNER_PREVIEW_PAGES_ENABLED="false"
PARTNER_MANUAL_PAYOUT_ENABLED="false"

# Use a dedicated, randomly generated production secret. Changing it requires
# an application restart and invalidates referral cookies signed with the old key.
PARTNER_REFERRAL_SIGNING_SECRET=""

# New-partner defaults. Existing partner profiles and historical commissions
# retain the values that were assigned when they were created.
PARTNER_DEFAULT_COMMISSION_BPS="2000"
PARTNER_RECURRING_COMMISSION_MONTHS="12"
PARTNER_REFERRAL_WINDOW_DAYS="30"
PARTNER_COMMISSION_HOLD_DAYS="30"
PARTNER_MINIMUM_PAYOUT_CENTS="5000"
PARTNER_SCANNER_DAILY_LIMIT="25"
PARTNER_SCANNER_MONTHLY_LIMIT="500"
PARTNER_SCAN_CACHE_DAYS="30"
PARTNER_ALLOWED_COUNTRIES="US"
PARTNER_TERMS_VERSION="1.0"
PARTNER_TRAINING_VERSION="1.0"

# Optional HTTPS-only community destination shown to certified partners.
PARTNER_COMMUNITY_URL=""

RESEND_API_KEY=""

EMAIL_FROM_NAME="Onread"
EMAIL_FROM_ADDRESS="notifications@updates.onread.ai"
EMAIL_REPLY_TO="support@onread.ai"

# Dedicated HMAC secret for hashing email verification codes and signing the
# temporary verification flow cookie. Generate a separate random value.
EMAIL_VERIFICATION_SECRET=""

# Separate HMAC secret for opaque password-reset tokens.
PASSWORD_RESET_SECRET=""

# Separate HMAC secret for distributed abuse-control keys. Keep server-only.
RATE_LIMIT_SECRET=""
SECURITY_EVENT_RETENTION_DAYS="31"

# Local fixture scripts refuse to run unless this is explicitly enabled and
# DATABASE_URL points to localhost. Never set this in Vercel.
ALLOW_DEVELOPMENT_FIXTURES="false"
